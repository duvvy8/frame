{
  "manifest_version": 3,
  "name": "Frame sidebar",
  "version": "0.2.0",
  "description": "Frame's favourite sites and browser utilities.",
  "permissions": [
    "sidePanel",
    "tabs",
    "storage"
  ],
  "action": {
    "default_title": "Open Frame sidebar"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "key": ""
}
